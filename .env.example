HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
COMMAND_START=["", "/"]
PUPULIN_DATABASE=data/pupulin.db
PUPULIN_PAIPUYA_BASE_URL=https://5-data.amae-koromo.com/api/v2/pl4
PUPULIN_PAIPUYA_SANMA_BASE_URL=https://5-data.amae-koromo.com/api/v2/pl3
# Authorized API key: standard Authorization: Bearer header, fixed 5-data API host.
PUPULIN_PAIPUYA_API_TOKEN=
# Shared across four-player/sanma, polling, queries and retries: max 1 QPS.
PUPULIN_PAIPUYA_RATE_LIMIT_FILE=data/paipuya-rate.sqlite
# Optional backup ONLY after HTTP401 or an explicit invalid/expired-key response.
# Timeouts, ordinary 403, 429 and server errors never activate the backup.
# pip install '.[cap]' and build the native library before enabling.
PUPULIN_PAIPUYA_AUTO_CAP=false
PUPULIN_CAP_WORKERS=2
PUPULIN_CAP_TIMEOUT=60
PUPULIN_CAP_CACHE_DIR=data/cap
# Optional absolute path to a compatible libhashwx.dylib/.so/.dll.
PUPULIN_HASHWX_LIBRARY=
PUPULIN_MONITOR_INTERVAL=60
# Disable only Mahjong Soul start notifications; finish notifications remain active.
PUPULIN_MONITOR_NOTIFY_START=false
# Only this QQ account can add/remove Mahjong Soul and Tenhou group monitoring targets.
PUPULIN_MONITOR_OWNER=
# In these groups, regular members can bind and query. VIP2 members can also use Mortal.
PUPULIN_MONITOR_ONLY_GROUPS=[]
PUPULIN_MONITOR_PAGE_SIZE=20
PUPULIN_MONITOR_CATCHUP_LIMIT=200
PUPULIN_REVIEW_QUEUE_SIZE=20
PUPULIN_BATCH_DIRECTORY=data/batches
# An HTTP bridge that accepts POST /review {"url": "...", "seat": 0}
PUPULIN_MORTAL_API_URL=
PUPULIN_MORTAL_API_TOKEN=
# pip install '.[online]'; local batchmortal SeleniumBase UC backend.
PUPULIN_MORTAL_ONLINE=false
PUPULIN_MORTAL_BROWSER_PROFILE=data/mortal-chrome
PUPULIN_MORTAL_ONLINE_MODEL=4.1b
PUPULIN_MORTAL_ONLINE_COOLDOWN=10
PUPULIN_MORTAL_ONLINE_TIMEOUT=600
PUPULIN_MORTAL_ONLINE_HEADLESS=true
PUPULIN_MORTAL_ONLINE_RETRIES=2
PUPULIN_MORTAL_ONLINE_PROXY=
PUPULIN_MORTAL_SAVE_HTML=true
PUPULIN_MORTAL_SAVE_SCREENSHOT=false
# Optional live-presence gateway; enables genuine pre-settlement start alerts.
PUPULIN_LIVE_API_URL=
PUPULIN_LIVE_API_TOKEN=

# 单次牌谱屋响应等待秒数；网络读取失败会限速重试一次
PUPULIN_PAIPUYA_TIMEOUT=60

# Optional read-only spectator browser; manually log in in its separate Chrome window.
PUPULIN_SPECTATOR_BROWSER=false
PUPULIN_SPECTATOR_BROWSER_PROFILE=data/majsoul-spectator
# Optional official replay headers for Mortal, using the same manually signed-in profile.
PUPULIN_MAJSOUL_RECORD_BROWSER=false
PUPULIN_MAJSOUL_RECORD_KEEPALIVE=false

# One-time home for pre-migration personal favorites without active monitors.
# Leave empty to keep unassigned rows in legacy_ms_follows for manual recovery.
PUPULIN_LEGACY_FOLLOW_GROUP=

# Global Bot superusers can use all commands in every group and manage all Mortal tasks.
SUPERUSERS=[]
